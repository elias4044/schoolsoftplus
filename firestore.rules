rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null && request.auth.token.identityVersion == 2 && request.auth.uid.matches('^[1-9][0-9]*$');
    }
    function isParticipant(data) {
      return isAuthed() && request.auth.uid in data.participantIds;
    }
    function isParticipantOf(conversationId) {
      return isParticipant(get(/databases/$(database)/documents/conversations_v1/$(conversationId)).data);
    }
    function isCallParty(data) {
      return isAuthed() && (request.auth.uid == data.callerUserId || request.auth.uid == data.calleeUserId);
    }
    function isGroupMember(callId) {
      return isParticipantOf(get(/databases/$(database)/documents/group_calls_v2/$(callId)).data.conversationId);
    }
    function isConnectionParty(callId, connectionKey) {
      let connection = get(/databases/$(database)/documents/group_calls_v2/$(callId)/connections/$(connectionKey)).data;
      return isGroupMember(callId) && (request.auth.uid == connection.initiatorUserId || request.auth.uid == connection.responderUserId);
    }

    match /profiles_v1/{userId} {
      allow read: if isAuthed();
      allow write: if false;
    }
    match /conversations_v1/{conversationId} {
      allow read: if isParticipant(resource.data);
      allow update: if isParticipant(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt']) &&
        request.resource.data.lastReadAt.diff(resource.data.lastReadAt).affectedKeys().hasOnly([request.auth.uid]);
      allow create, delete: if false;
    }
    match /messages_v1/{messageId} {
      allow read: if isParticipantOf(resource.data.conversationId);
      allow write: if false;
    }
    match /friendships_v1/{friendshipId} {
      allow read: if isAuthed() && (request.auth.uid == resource.data.userAId || request.auth.uid == resource.data.userBId);
      allow write: if false;
    }
    match /presence_v1/{userId} {
      allow read: if isAuthed();
      allow write: if false;
    }
    match /group_invites_v1/{inviteId} {
      allow read: if isAuthed() && (request.auth.uid == resource.data.invitedUserId || request.auth.uid == resource.data.invitedById);
      allow write: if false;
    }
    match /calls_v1/{callId} {
      allow read, delete: if isCallParty(resource.data);
      allow create: if isAuthed() && request.auth.uid == request.resource.data.callerUserId &&
        request.resource.data.calleeUserId.matches('^[1-9][0-9]*$') && request.resource.data.calleeUserId != request.auth.uid;
      allow update: if isCallParty(resource.data) &&
        request.resource.data.callerUserId == resource.data.callerUserId &&
        request.resource.data.calleeUserId == resource.data.calleeUserId;
      match /{candidateCollection}/{candidateId} {
        allow read, create, delete: if candidateCollection in ['callerCandidates', 'calleeCandidates'] &&
          isCallParty(get(/databases/$(database)/documents/calls_v1/$(callId)).data);
      }
    }
    match /group_calls_v2/{callId} {
      allow read: if isParticipantOf(resource.data.conversationId);
      allow create: if isAuthed() && isParticipantOf(request.resource.data.conversationId) &&
        request.resource.data.startedByUserId == request.auth.uid &&
        request.resource.data.participantIds == [request.auth.uid] && request.resource.data.status == 'active';
      allow update: if isParticipantOf(resource.data.conversationId) &&
        request.resource.data.conversationId == resource.data.conversationId &&
        request.resource.data.startedByUserId == resource.data.startedByUserId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'status', 'endedAt']) &&
        request.resource.data.participantIds.toSet().difference(resource.data.participantIds.toSet()).hasOnly([request.auth.uid]) &&
        resource.data.participantIds.toSet().difference(request.resource.data.participantIds.toSet()).hasOnly([request.auth.uid]);
      allow delete: if false;
      match /connections/{connectionKey} {
        allow read, delete: if isGroupMember(callId) &&
          (request.auth.uid == resource.data.initiatorUserId || request.auth.uid == resource.data.responderUserId);
        allow create: if isGroupMember(callId) && request.auth.uid == request.resource.data.initiatorUserId &&
          request.resource.data.responderUserId in get(/databases/$(database)/documents/group_calls_v2/$(callId)).data.participantIds;
        allow update: if isConnectionParty(callId, connectionKey) &&
          request.resource.data.initiatorUserId == resource.data.initiatorUserId &&
          request.resource.data.responderUserId == resource.data.responderUserId;
        match /{direction}/{candidateId} {
          allow read, create, delete: if direction in ['fromInitiator', 'fromResponder'] && isConnectionParty(callId, connectionKey);
        }
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
