rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────

    // Is the caller signed in (via Firebase custom token)?
    function isAuthed() {
      return request.auth != null && request.auth.uid != null;
    }

    // Is the caller the owner of this document (keyed by uid/username)?
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // Is the caller a participant in a conversation document?
    function isParticipant(convData) {
      return isAuthed() && request.auth.uid in convData.participants;
    }

    // Is the caller a participant in a given conversation by ID?
    function isParticipantOf(convId) {
      return isAuthed() &&
        request.auth.uid in
          get(/databases/$(database)/documents/conversations_v1/$(convId)).data.participants;
    }

    // ── Profiles ──────────────────────────────────────────
    // Any authenticated user can read any profile (needed for search + DM name display).
    // Only the profile owner can write their own document.
    match /profiles_v1/{username} {
      allow read:  if isAuthed();
      allow write: if isOwner(username);
    }

    // ── Conversations ──────────────────────────────────────
    // Only participants can read a conversation.
    // Participants may update only their own lastReadAt timestamp for cross-device read sync.
    // All other writes go through the server-side API (Admin SDK bypasses rules).
    match /conversations_v1/{convId} {
      allow read:   if isParticipant(resource.data);
      // Allow participants to update ONLY the lastReadAt map (cross-device unread sync)
      allow update: if isParticipant(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt']);
      allow write:  if false;
    }

    // ── Messages ──────────────────────────────────────────
    // Participants of the parent conversation can read messages.
    // Writes go through the server-side API only.
    match /messages_v1/{msgId} {
      allow read:  if isAuthed() && isParticipantOf(resource.data.conversationId);
      allow write: if false;
    }

    // ── Notes ─────────────────────────────────────────────
    // Entirely server-side; the client SDK never touches these.
    match /notes_v2/{noteId} {
      allow read, write: if false;
    }

    // ── Countdowns ────────────────────────────────────────
    match /countdowns_v1/{countdownId} {
      allow read, write: if false;
    }

    // ── Stats ─────────────────────────────────────────────
    // Publicly readable (used by the /stats page).
    // Writes are server-only (Admin SDK bypasses rules).
    match /stats/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Friendships ───────────────────────────────────────
    // A friendship document has userA and userB fields (both set to the username/uid).
    // Only the two parties involved can read their friendship doc.
    // All writes go through the server-side API (Admin SDK bypasses rules).
    match /friendships_v1/{friendshipId} {
      allow read: if isAuthed() &&
        (request.auth.uid == resource.data.userA ||
         request.auth.uid == resource.data.userB);
      allow write: if false;
    }

    // ── Presence ──────────────────────────────────────────
    // Any authenticated user can read presence (needed for status dots).
    // Only the owner can write their own presence document.
    match /presence_v1/{username} {
      allow read:  if isAuthed();
      allow write: if isOwner(username);
    }

    // ── Group Invites ─────────────────────────────────────
    // The invited user and the inviter can read an invite document.
    // All writes go through the server-side API.
    match /group_invites_v1/{inviteId} {
      allow read: if isAuthed() &&
        (request.auth.uid == resource.data.invitedUsername ||
         request.auth.uid == resource.data.invitedBy);
      allow write: if false;
    }

    // ── Voice Calls (WebRTC signaling) ────────────────────
    // Both caller and callee can read/list call documents.
    // list: Firestore query rules must not rely on resource.data, so we allow
    //       any authenticated user to *list* — the where() clause in the client
    //       already scopes results to calleeUsername == uid, which Firestore
    //       enforces at the query level. Individual document reads are still
    //       gated below.
    match /calls_v1/{callId} {
      allow list: if isAuthed();
      allow get: if isAuthed() && (
        request.auth.uid == resource.data.callerUsername ||
        request.auth.uid == resource.data.calleeUsername
      );
      allow create: if isAuthed() &&
        request.auth.uid == request.resource.data.callerUsername;
      allow update: if isAuthed() && (
        request.auth.uid == resource.data.callerUsername ||
        request.auth.uid == resource.data.calleeUsername
      );
      allow delete: if isAuthed() && (
        request.auth.uid == resource.data.callerUsername ||
        request.auth.uid == resource.data.calleeUsername
      );

      // ICE candidates — both parties can read/write/delete
      match /callerCandidates/{candidateId} {
        allow read, create, delete: if isAuthed() && (
          request.auth.uid == get(/databases/$(database)/documents/calls_v1/$(callId)).data.callerUsername ||
          request.auth.uid == get(/databases/$(database)/documents/calls_v1/$(callId)).data.calleeUsername
        );
      }
      match /calleeCandidates/{candidateId} {
        allow read, create, delete: if isAuthed() && (
          request.auth.uid == get(/databases/$(database)/documents/calls_v1/$(callId)).data.callerUsername ||
          request.auth.uid == get(/databases/$(database)/documents/calls_v1/$(callId)).data.calleeUsername
        );
      }
    }
    // ── Group Voice Calls (WebRTC signaling — mesh) ───────────
    // Any authenticated user may read/write active group call documents.
    // The conversationId in the document ties access to a conversation,
    // but we keep rules simple here since conversation membership is
    // enforced at the query level and client-side guards.
    match /group_calls_v2/{callId} {
      allow read, list: if isAuthed();
      allow create: if isAuthed() &&
        request.auth.uid == request.resource.data.startedBy &&
        request.resource.data.status == "active";
      allow update: if isAuthed();
      allow delete: if false;

      match /connections/{connectionKey} {
        allow read, write: if isAuthed();

        match /fromInitiator/{candidateId} {
          allow read, create, delete: if isAuthed();
        }
        match /fromResponder/{candidateId} {
          allow read, create, delete: if isAuthed();
        }
      }
    }
    // ── Referrals ─────────────────────────────────────────
    // Authenticated users can read their own referral doc (for the dashboard).
    // All writes go through the server-side API (Admin SDK bypasses rules).
    match /referrals_v1/{username} {
      allow read: if isOwner(username);
      allow write: if false;
    }

    // Referral code lookup — publicly readable so the join page can
    // display the referrer's name without requiring authentication.
    // No sensitive data is stored here (just username + createdAt).
    match /referral_codes_v1/{code} {
      allow read: if true;
      allow write: if false;
    }

    // ── Default deny ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
